<?xml version="1.0" encoding="utf-8"?>
<!-- 入库 / 出库界面：表头 + 表格（每一行见 order_row.xml） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/order_edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/text_order_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/order_editor_title_purchase"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 货号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_article_id"
                android:layout_width="64dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:text="@string/purchase_order_article_id"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/article_id_fill"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/edit_border"
                android:hint="@string/article_id_hint"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                tools:ignore="LabelFor" />
        </LinearLayout>

        <!-- 货名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_article_name"
                android:layout_width="64dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:text="@string/purchase_order_article_name"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/article_name_fill"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/edit_border"
                android:hint="@string/article_name_hint"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                tools:ignore="LabelFor" />
        </LinearLayout>

        <!-- 经销商（出库时隐藏） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_dealer"
                android:layout_width="64dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:text="@string/purchase_order_dealer"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/dealer_fill"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/edit_border"
                android:hint="@string/dealer_hint"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                tools:ignore="LabelFor" />
        </LinearLayout>

        <!-- 价格：入库是进价，出库是售价 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_price"
                android:layout_width="64dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:text="@string/purchase_order_price"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/price_fill"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/edit_border"
                android:hint="@string/purchase_price_hint"
                android:inputType="numberDecimal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                tools:ignore="LabelFor" />
        </LinearLayout>

        <!-- 加号：新增一行 -->
        <Button
            android:id="@+id/btn_add_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_order_row" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_purchase_table"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            tools:listitem="@layout/order_row" />

        <!-- 取消 / 确定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/btn_confirm_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/confirm" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
